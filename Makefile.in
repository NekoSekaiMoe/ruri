maintainer-clean: maintainer-clean-am
	-rm -f $(am__CONFIG_DISTCLEAN_FILES)
	-rm -rf $(top_srcdir)/autom4te.cache
	-rm -f src/$(DEPDIR)/ruri-caplist.Po
	-rm -f src/$(DEPDIR)/ruri-cgroup.Po
	-rm -f src/$(DEPDIR)/ruri-chroot.Po
	-rm -f src/$(DEPDIR)/ruri-config.Po
	-rm -f src/$(DEPDIR)/ruri-cprintf.Po
	-rm -f src/$(DEPDIR)/ruri-elf-magic.Po
	-rm -f src/$(DEPDIR)/ruri-env.Po
	-rm -f src/$(DEPDIR)/ruri-info.Po
	-rm -f src/$(DEPDIR)/ruri-k2v.Po
	-rm -f src/$(DEPDIR)/ruri-mount.Po
	-rm -f src/$(DEPDIR)/ruri-passwd.Po
	-rm -f src/$(DEPDIR)/ruri-ps.Po
	-rm -f src/$(DEPDIR)/ruri-ruri.Po
	-rm -f src/$(DEPDIR)/ruri-seccomp.Po
	-rm -f src/$(DEPDIR)/ruri-signal.Po
	-rm -f src/$(DEPDIR)/ruri-umount.Po
	-rm -f src/$(DEPDIR)/ruri-unshare.Po
